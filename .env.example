# Claude API (required for chat and BRD generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FALLBACK_MODELS=claude-sonnet-4-6,claude-sonnet-4-5,claude-haiku-4-5,claude-opus-4-6

# Services
PYTHON_SERVICE_URL=http://localhost:8000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Local storage paths (relative to python service)
DATA_DIR=../../data
DATABASE_URL=sqlite:///../../data/brd.db
CHROMA_DIR=../../data/chroma
UPLOAD_DIR=../../data/uploads
